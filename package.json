{
  "name": "oxlint-plugin-decision-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fallow": "fallow --production --quiet --format compact && fallow dead-code --no-production --quiet --format compact && fallow dupes --quiet --format compact && fallow security --fail-on-issues --quiet",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@types/node": "catalog:",
    "eslint-plugin-no-comments": "catalog:",
    "fallow": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

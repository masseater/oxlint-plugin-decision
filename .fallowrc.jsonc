{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "production": true,
  "boundaries": {
    "zones": [
      { "name": "apps", "patterns": ["apps/**"], "autoDiscover": ["apps"] },
      { "name": "libs", "patterns": ["libs/**"] },
      { "name": "tools", "patterns": ["tools/**"], "autoDiscover": ["tools"] },
      { "name": "infra", "patterns": ["infra/**"], "autoDiscover": ["infra"] },
    ],
    "rules": [
      { "from": "apps", "allow": ["libs", "infra"] },
      { "from": "libs", "allow": [] },
      { "from": "tools", "allow": ["libs"] },
      { "from": "infra", "allow": ["libs"] },
    ],
  },
  "typeAware": { "enabled": true, "require": "complete" },
  "failOnParseError": true,
  "ignorePatterns": [".claude/**", "libs/*/example/**"],
  "dynamicallyLoaded": ["libs/oxlint-plugin-decision/src/openrouter-worker.ts"],
  "audit": { "gate": "all" },
  "health": {
    "coverage": "libs/oxlint-plugin-decision/coverage/coverage-final.json",
    "maxCrap": 5,
  },
  "security": {
    "categories": {
      "include": [
        "angular-trusted-html",
        "cleartext-transport",
        "code-injection",
        "command-injection",
        "dangerous-html",
        "deprecated-cipher",
        "dom-document-write",
        "dynamic-module-load",
        "dynamic-regex",
        "electron-unsafe-webpreferences",
        "hardcoded-secret",
        "header-injection",
        "insecure-cookie",
        "insecure-randomness",
        "insecure-temp-file",
        "jquery-html",
        "jwt-alg-none",
        "jwt-verify-missing-algorithms",
        "llm-call-injection",
        "mass-assignment",
        "mysql-multiple-statements",
        "nextjs-open-redirect",
        "nosql-injection",
        "open-redirect",
        "path-traversal",
        "permissive-cors",
        "postmessage-wildcard-origin",
        "prototype-pollution",
        "redos-regex",
        "resource-amplification",
        "route-send-file",
        "secret-pii-log",
        "secret-to-network",
        "sql-injection",
        "ssrf",
        "ssti",
        "template-escape-bypass",
        "tls-validation-disabled",
        "unsafe-buffer-alloc",
        "unsafe-deserialization",
        "weak-crypto",
        "webview-injection",
        "world-writable-permission",
        "xpath-injection",
        "xxe",
        "zip-slip",
      ],
    },
  },
  "duplicates": { "threshold": 1, "ignore": ["**/generated/**"] },
  "framework": [
    {
      "name": "vite-plus",
      "enablers": ["vite-plus"],
      "entryPoints": ["vite.config.ts"],
      "toolingDependencies": ["@ast-grep/cli", "eslint-plugin-no-comments"],
    },
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "deprecated-exports-in-use": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "off",
    "feature-flags": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
  },
}

{
  "name": "@r_masseater/oxlint-plugin-decision",
  "version": "0.0.4",
  "description": "Oxlint JS plugin that lints code with plain-English rules answered by decision models on OpenRouter.",
  "keywords": [
    "decision-model",
    "lint",
    "openrouter",
    "oxlint",
    "oxlint-plugin",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/oxlint-plugin-decision#readme",
  "bugs": {
    "url": "https://github.com/masseater/oxlint-plugin-decision/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/oxlint-plugin-decision.git",
    "directory": "libs/oxlint-plugin-decision"
  },
  "files": [
    "dist",
    "skills/write-decision-rules"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --project=mock --coverage",
    "example": "vp run build && ./node_modules/oxlint/bin/oxlint -c example/oxlint.config.ts example/",
    "prepublishOnly": "vp run build",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@openrouter/sdk": "catalog:",
    "effect": "catalog:stack",
    "synckit": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:stack",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:stack",
    "oxlint": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "oxlint": ">=1.87.0"
  },
  "engines": {
    "node": ">=20"
  }
}

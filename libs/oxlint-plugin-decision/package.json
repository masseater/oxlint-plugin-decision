{
  "name": "oxlint-plugin-decision",
  "version": "0.2.0",
  "description": "Oxlint JS plugin that lints code with plain-English rules answered by decision models on OpenRouter.",
  "keywords": [
    "decision-model",
    "lint",
    "openrouter",
    "oxlint",
    "oxlint-plugin"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "example": "vp run build && ./node_modules/oxlint/bin/oxlint -c example/.oxlintrc.json example/",
    "prepublishOnly": "vp run build",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@openrouter/sdk": "catalog:",
    "effect": "catalog:stack",
    "synckit": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:stack",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "oxlint": ">=1.87.0"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "oxlint-plugin-decision",
  "version": "0.1.3",
  "description": "Oxlint JS plugin that lints code with plain-English rules answered by TypeSafe Jev.",
  "keywords": [
    "jev",
    "lint",
    "oxlint",
    "oxlint-plugin",
    "typesafe"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "example": "vp run build && ./node_modules/oxlint/bin/oxlint -c example/.oxlintrc.json example/",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "catalog:",
    "synckit": "catalog:"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "oxlint": ">=1.87.0"
  },
  "engines": {
    "node": ">=20"
  }
}

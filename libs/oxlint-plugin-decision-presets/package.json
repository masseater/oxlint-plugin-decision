{
  "name": "@r_masseater/oxlint-plugin-decision-presets",
  "version": "0.0.1",
  "description": "Ready-made plain-English rule presets for @r_masseater/oxlint-plugin-decision.",
  "keywords": [
    "decision-model",
    "lint",
    "openrouter",
    "oxlint",
    "oxlint-plugin",
    "preset"
  ],
  "homepage": "https://github.com/masseater/oxlint-plugin-decision/tree/main/libs/oxlint-plugin-decision-presets#readme",
  "bugs": {
    "url": "https://github.com/masseater/oxlint-plugin-decision/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/oxlint-plugin-decision.git",
    "directory": "libs/oxlint-plugin-decision-presets"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#example/*": "./example/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./recommended": {
      "types": "./dist/recommended.d.mts",
      "default": "./dist/recommended.mjs"
    },
    "./strict": {
      "types": "./dist/strict.d.mts",
      "default": "./dist/strict.mjs"
    },
    "./review-only": {
      "types": "./dist/review-only.d.mts",
      "default": "./dist/review-only.mjs"
    },
    "./ai-slop": {
      "types": "./dist/ai-slop.d.mts",
      "default": "./dist/ai-slop.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --project=mock --coverage",
    "example": "vp run build && ./node_modules/oxlint/bin/oxlint -c example/.oxlintrc.json example/",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@r_masseater/oxlint-plugin-decision": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:stack",
    "effect": "catalog:stack",
    "oxlint": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@r_masseater/oxlint-plugin-decision": "workspace:^",
    "oxlint": ">=1.87.0"
  },
  "engines": {
    "node": ">=20"
  }
}
